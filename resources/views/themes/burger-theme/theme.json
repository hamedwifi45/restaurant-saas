{
  "name": "برجر 2 كلاسيك",
  "author": "منصة المطاعم",
  "version": "2.0.0",
  "slug": "classic-2-burger",

  "allowed_variables": {
    "primary_color": {
      "section": "الألوان والخطوط",
      "type": "color",
      "label": "اللون الرئيسي",
      "description": "يُستخدم في الأزرار والعناصر التفاعلية",
      "default": "#FF6B35",
      "css_var": "--primary-color"
    },
    "secondary_color": {
      "section": "الألوان والخطوط",
      "type": "color",
      "label": "اللون الثانوي",
      "default": "#FFFFFF",
      "css_var": "--secondary-color"
    },
    "background_color": {
      "section": "الألوان والخطوط",
      "type": "color",
      "label": "لون الخلفية",
      "default": "#1A1A1A",
      "css_var": "--bg-color"
    },
    "font_family": {
      "section": "الألوان والخطوط",
      "type": "select",
      "label": "نوع الخط العربي",
      "options": {
        "Tajawal": "Tajawal (عصري)",
        "Cairo": "Cairo (واضح)",
        "Almarai": "Almarai (أنيق)"
      },
      "default": "Tajawal",
      "css_var": "--font-family"
    },
    "header_style": {
      "section": "الهيدر والبانر",
      "type": "select",
      "label": "شكل القائمة العلوية",
      "options": {
        "sticky": "ثابت في الأعلى",
        "transparent": "شفاف فوق الصورة"
      },
      "default": "sticky"
    },
    "show_hero_banner": {
      "section": "الهيدر والبانر",
      "type": "toggle",
      "label": "إظهار البانر الرئيسي",
      "default": true
    },
    "hero_title": {
      "section": "الهيدر والبانر",
      "type": "text",
      "label": "عنوان البانر",
      "default": "أشهى البرجر في المدينة"
    },
    "hero_subtitle": {
      "section": "الهيدر والبانر",
      "type": "text",
      "label": "العنوان الفرعي",
      "default": "تجربة طعم لا تُقاوم"
    },
    "border_radius": {
      "section": "تصميم البطاقات",
      "type": "select",
      "label": "انحناء الحواف",
      "options": {
        "0px": "مربع",
        "4px": "خفيف",
        "8px": "متوسط",
        "16px": "دائري"
      },
      "default": "8px",
      "css_var": "--border-radius"
    },
    "card_style": {
      "section": "تصميم البطاقات",
      "type": "select",
      "label": "شكل البطاقات",
      "options": {
        "elevated": "بارزة بظل",
        "flat": "مسطحة بإطار"
      },
      "default": "elevated"
    }
  }
}